#!/usr/bin/env python3
"""Notify once when this boot resumes from hibernation."""

import json
import os
from pathlib import Path
import subprocess
import sys
from datetime import datetime


def last_hibernation():
    result = subprocess.run(
        ["journalctl", "-b", "--no-pager", "-o", "json",
         "SYSLOG_IDENTIFIER=systemd-sleep"],
        capture_output=True, text=True, check=True,
    )
    for line in reversed(result.stdout.splitlines()):
        entry = json.loads(line)
        if entry.get("MESSAGE") == "Performing sleep operation 'hibernate'...":
            return entry
    return None


def main():
    state_dir = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "hibernation-notification"
    state_file = state_dir / "last-event"
    entry = last_hibernation()
    if entry is None:
        if not state_file.exists():
            state_dir.mkdir(parents=True, exist_ok=True)
            state_file.write_text("none\n")
        return 0

    key = f"{entry['_BOOT_ID']}:{entry['__REALTIME_TIMESTAMP']}"
    if "--print" not in sys.argv and state_file.exists() and state_file.read_text().strip() == key:
        return 0

    # On first installation, do not notify about an old hibernation.
    if "--print" not in sys.argv and not state_file.exists():
        state_dir.mkdir(parents=True, exist_ok=True)
        state_file.write_text(key + "\n")
        return 0

    happened = datetime.fromtimestamp(int(entry["__REALTIME_TIMESTAMP"]) / 1_000_000)
    sleep_kind = entry.get("SLEEP", "hibernate")
    if sleep_kind == "suspend-then-hibernate":
        reason = "Suspend-then-hibernate policy: 12 hours on battery or low battery."
    else:
        reason = "A direct hibernation request was made."
    title = f"Laptop hibernated at {happened:%-I:%M %p}"
    body = f"{happened:%a %b %-d}. {reason}"

    if "--print" in sys.argv:
        print(title)
        print(body)
        return 0

    subprocess.run(
        ["notify-send", "--app-name=Hibernation", "--icon=system-suspend-hibernate-symbolic",
         "--urgency=normal", "--expire-time=15000", title, body],
        check=True,
    )
    state_dir.mkdir(parents=True, exist_ok=True)
    state_file.write_text(key + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())

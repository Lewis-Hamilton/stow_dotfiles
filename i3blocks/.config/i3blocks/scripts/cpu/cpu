#!/bin/bash

source ~/.my_colors.sh

# Compare stat between intervals
state_dir=${XDG_RUNTIME_DIR:-/tmp}/i3blocks-$UID
mkdir -p "$state_dir"
chmod 700 "$state_dir"

previous_stat=$state_dir/cpu-stat
current_stat=$state_dir/cpu-stat.$$
awk '/^cpu/ { print }' /proc/stat > "$current_stat"

# Get first cpu usage before previous comparison exists
if [ ! -s "$previous_stat" ]; then
    mv "$current_stat" "$previous_stat"
    sleep 0.2
    current_stat=$state_dir/cpu-stat.$$
    awk '/^cpu/ { print }' /proc/stat > "$current_stat"
fi

read -r CPU_USAGE BUSIEST_CORE_USAGE < <(
    awk '
        NR == FNR {
            for (field = 2; field <= NF; field++) {
                previous[$1, field] = $field
            }
            next
        }
        /^cpu/ {
            total = 0
            idle = 0
            for (field = 2; field <= NF; field++) {
                delta = $field - previous[$1, field]
                total += delta
                if (field == 5 || field == 6) idle += delta
            }
            usage = total > 0 ? 100 * (total - idle) / total : 0
            usage = int(usage + 0.5)
            if ($1 == "cpu") average = usage
            else if (usage > busiest) busiest = usage
        }
        END { print average + 0, busiest + 0 }
    ' "$previous_stat" "$current_stat"
)
mv "$current_stat" "$previous_stat"

usage_color_for() {
    local usage=$1
    if [ "$usage" -le 50 ]; then
        echo "$MY_GREEN"
    elif [ "$usage" -le 70 ]; then
        echo "$MY_YELLOW"
    elif [ "$usage" -le 85 ]; then
        echo "$MY_ORANGE"
    else
        echo "$MY_RED"
    fi
}

usage_color=$(usage_color_for "$CPU_USAGE")
busiest_core_color=$(usage_color_for "$BUSIEST_CORE_USAGE")
OUTPUT_VALUE=${CPU_USAGE}%
BUSIEST_CORE_VALUE=${BUSIEST_CORE_USAGE}%

# Show the fastest current core. This stays meaningful on hybrid CPUs where
# idle cores may sit at their minimum frequency while active cores boost.
frequency_files=(/sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq)
if [ -e "${frequency_files[0]}" ]; then
    max_frequency_khz=$(awk '
        $1 > fastest { fastest = $1 }
        END { print fastest + 0 }
    ' "${frequency_files[@]}" 2>/dev/null)

    frequency_tenths=$(((max_frequency_khz + 50000) / 100000))
    formatted_frequency=$((frequency_tenths / 10)).$((frequency_tenths % 10))GHz

    # A low clock is normal while idle. Highlight it only when the CPU is also
    # busy, which catches the 400 MHz power/firmware throttle seen in meetings.
    if [ "$max_frequency_khz" -le 600000 ] && \
        { [ "$CPU_USAGE" -ge 10 ] || [ "$BUSIEST_CORE_USAGE" -ge 25 ]; }; then
        frequency_color=$MY_RED
    elif [ "$max_frequency_khz" -le 1200000 ] && \
        { [ "$CPU_USAGE" -ge 20 ] || [ "$BUSIEST_CORE_USAGE" -ge 50 ]; }; then
        frequency_color=$MY_ORANGE
    else
        frequency_color=$MY_GREEN
    fi
else
    formatted_frequency="n/a"
    frequency_color=$MY_RED
fi

# CPU Temperature and Fan Speed
cpu_script_dir=$(dirname -- "${BASH_SOURCE[0]}")
read -r formatted_temperature fan_speed < <("$cpu_script_dir/thermal")

if [[ $formatted_temperature =~ ^[0-9]+$ ]] && [ "$formatted_temperature" -le 50 ]; then
    temp_color=$MY_GREEN
elif [[ $formatted_temperature =~ ^[0-9]+$ ]] && [ "$formatted_temperature" -le 60 ]; then
    temp_color=$MY_YELLOW
elif [[ $formatted_temperature =~ ^[0-9]+$ ]] && [ "$formatted_temperature" -le 70 ]; then
    temp_color=$MY_ORANGE
else
    temp_color=$MY_RED
fi

if [[ $fan_speed =~ ^[0-9]+$ ]] && [ "$fan_speed" -le 800 ]; then
    fan_color=$MY_GREEN
elif [[ $fan_speed =~ ^[0-9]+$ ]] && [ "$fan_speed" -le 1600 ]; then
    fan_color=$MY_YELLOW
elif [[ $fan_speed =~ ^[0-9]+$ ]] && [ "$fan_speed" -le 2400 ]; then
    fan_color=$MY_ORANGE
else
    fan_color=$MY_RED
fi

printf -v padded_usage "%3s" "$OUTPUT_VALUE"
printf -v padded_busiest_core "%4s" "$BUSIEST_CORE_VALUE"
if [[ $fan_speed =~ ^[0-9]+$ ]]; then
    printf -v padded_fan_speed "%04d" "$fan_speed"
else
    padded_fan_speed=$fan_speed
fi

divider="<span color=\"#888888\">][</span>"
front_divider="<span color=\"#888888\">[</span>"
back_divider="<span color=\"#888888\">]</span>"


echo "<span size='large'>󰟀$front_divider</span><span color=\"$busiest_core_color\">$padded_busiest_core ↑</span>$divider<span color=\"$usage_color\">$padded_usage</span><span color=\"$usage_color\" size='large'> 󰓅</span>$divider<span color=\"$frequency_color\">$formatted_frequency</span>$divider<span color=\"$temp_color\">$formatted_temperature°C </span><span color=\"$temp_color\" size='large'></span>$divider<span color=\"$fan_color\">$padded_fan_speed </span><span color=\"$fan_color\" size='large'>󰈐</span>$back_divider"

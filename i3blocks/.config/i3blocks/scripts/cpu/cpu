#!/bin/bash

source ~/.my_colors.sh

# Keep state between i3blocks invocations so /proc/stat counters can be
# converted into usage over the last interval.
state_dir=${XDG_RUNTIME_DIR:-/tmp}/i3blocks-$UID
mkdir -p "$state_dir"
chmod 700 "$state_dir"

previous_stat=$state_dir/cpu-stat
current_stat=$state_dir/cpu-stat.$$
awk '/^cpu/ { print }' /proc/stat > "$current_stat"

# Seed the first invocation with a short sample. Later invocations use the
# five-second interval between runs and do not sleep.
if [ ! -s "$previous_stat" ]; then
    mv "$current_stat" "$previous_stat"
    sleep 0.2
    current_stat=$state_dir/cpu-stat.$$
    awk '/^cpu/ { print }' /proc/stat > "$current_stat"
fi

read -r CPU_USAGE BUSIEST_CORE_USAGE < <(
    awk '
        NR == FNR {
            for (field = 2; field <= NF; field++) {
                previous[$1, field] = $field
            }
            next
        }
        /^cpu/ {
            total = 0
            idle = 0
            for (field = 2; field <= NF; field++) {
                delta = $field - previous[$1, field]
                total += delta
                if (field == 5 || field == 6) idle += delta
            }

            usage = total > 0 ? 100 * (total - idle) / total : 0
            usage = int(usage + 0.5)
            if ($1 == "cpu") average = usage
            else if (usage > busiest) busiest = usage
        }
        END { print average + 0, busiest + 0 }
    ' "$previous_stat" "$current_stat"
)
mv "$current_stat" "$previous_stat"

usage_color_for() {
    local usage=$1
    if [ "$usage" -le 50 ]; then
        echo "$MY_GREEN"
    elif [ "$usage" -le 70 ]; then
        echo "$MY_YELLOW"
    elif [ "$usage" -le 85 ]; then
        echo "$MY_ORANGE"
    else
        echo "$MY_RED"
    fi
}

usage_color=$(usage_color_for "$CPU_USAGE")
busiest_core_color=$(usage_color_for "$BUSIEST_CORE_USAGE")
OUTPUT_VALUE=${CPU_USAGE}%
BUSIEST_CORE_VALUE=${BUSIEST_CORE_USAGE}%

# sensors is substantially more expensive than /proc/stat, so cache its
# temperature and fan readings for 15 seconds.
thermal_cache=$state_dir/cpu-thermal
now=$(date +%s)
thermal_cache_time=$(stat -c %Y "$thermal_cache" 2>/dev/null || echo 0)

if [ ! -s "$thermal_cache" ] || [ $((now - thermal_cache_time)) -ge 15 ]; then
    sensors_raw=$(sensors 2>/dev/null)

    if grep -q "PECI Agent 0" <<< "$sensors_raw"; then
        target_line=$(grep -m1 "PECI Agent 0" <<< "$sensors_raw")
    else
        target_line=$(grep -m1 'CPU:' <<< "$sensors_raw")
    fi

    temperature=$(awk -F '[+°]' '{print $2}' <<< "$target_line")
    new_temperature=$(awk '{printf "%.0f", $1}' <<< "$temperature")
    new_fan_speed=$(awk '$1 == "fan2:" {print $2; exit}' <<< "$sensors_raw")

    [[ $new_temperature =~ ^[0-9]+$ ]] || new_temperature=ERR
    [[ $new_fan_speed =~ ^[0-9]+$ ]] || new_fan_speed=ERR

    thermal_cache_tmp=$state_dir/cpu-thermal.$$
    printf '%s %s\n' "$new_temperature" "$new_fan_speed" > "$thermal_cache_tmp"
    mv "$thermal_cache_tmp" "$thermal_cache"
fi

if [ -s "$thermal_cache" ]; then
    read -r formatted_temperature fan_speed < "$thermal_cache"
else
    formatted_temperature=ERR
    fan_speed=ERR
fi

if [[ $formatted_temperature =~ ^[0-9]+$ ]] && [ "$formatted_temperature" -le 50 ]; then
    temp_color=$MY_GREEN
elif [[ $formatted_temperature =~ ^[0-9]+$ ]] && [ "$formatted_temperature" -le 60 ]; then
    temp_color=$MY_YELLOW
elif [[ $formatted_temperature =~ ^[0-9]+$ ]] && [ "$formatted_temperature" -le 70 ]; then
    temp_color=$MY_ORANGE
else
    temp_color=$MY_RED
fi

if [[ $fan_speed =~ ^[0-9]+$ ]] && [ "$fan_speed" -le 800 ]; then
    fan_color=$MY_GREEN
elif [[ $fan_speed =~ ^[0-9]+$ ]] && [ "$fan_speed" -le 1600 ]; then
    fan_color=$MY_YELLOW
elif [[ $fan_speed =~ ^[0-9]+$ ]] && [ "$fan_speed" -le 2400 ]; then
    fan_color=$MY_ORANGE
else
    fan_color=$MY_RED
fi

printf -v padded_usage "%3s" "$OUTPUT_VALUE"
printf -v padded_busiest_core "%4s" "$BUSIEST_CORE_VALUE"
if [[ $fan_speed =~ ^[0-9]+$ ]]; then
    printf -v padded_fan_speed "%04d" "$fan_speed"
else
    padded_fan_speed=$fan_speed
fi

echo "<span color=\"$fan_color\">$padded_fan_speed </span><span color=\"$fan_color\" size='large'>󰈐</span> - <span color=\"$usage_color\" size='large'>󰓅</span><span color=\"$usage_color\"> $padded_usage</span><span color=\"$busiest_core_color\"> ↑$padded_busiest_core</span><span size='large'> 󰟀 </span><span color=\"$temp_color\">$formatted_temperature°C </span><span color=\"$temp_color\" size='large'></span>"
